<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rmg_compliance" model="ir.module.category">
        <field name="name">Compliance</field>
    </record>
    <record id="group_cmp_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_rmg_compliance"/>
    </record>
    <record id="group_cmp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rmg_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_cmp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
