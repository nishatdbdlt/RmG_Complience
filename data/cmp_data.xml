<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_cmp_audit" model="ir.sequence">
        <field name="name">Compliance Audit</field>
        <field name="code">rmg.cmp.audit</field>
        <field name="prefix">CMP/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="cron_cmp_licenses" model="ir.cron">
        <field name="name">Compliance: check license expiry</field>
        <field name="model_id" ref="model_rmg_cmp_license"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_licenses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_cmp_audits" model="ir.cron">
        <field name="name">Compliance: create scheduled audits</field>
        <field name="model_id" ref="model_rmg_cmp_audit"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_audits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
